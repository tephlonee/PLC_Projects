  <POU Name="Control_FBD" Id="{84d3f40d-a0f6-423e-bc58-eeabb716185d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Control_FBD
VAR
	ixSensor1		AT %I*:	BOOL; 		//Pallet on sensor1 (S1)
	ixSensor2		AT %I*:	BOOL; 		//Pallet on sensor2 (S2)
	ixSensor3		AT %I*:	BOOL; 		//Pallet on sensor3 (S3)

	qxRunConveyor1	AT %Q*:	BOOL; 		// Motor that runs Conveyor 1*)
	qxRunConveyor2	AT %Q*:	BOOL; 		// Motor that runs Conveyor 2*)
	qxRunConveyor3	AT %Q*:	BOOL; 		// Motor that runs Conveyor 3*)	

	//Transport memory
	mxTrpConveyor1to2 : BOOL;
	mxTrpConveyor2to3 : BOOL;

END_VAR
]]></Declaration>

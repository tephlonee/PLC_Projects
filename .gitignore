# ---------------------------------------------------------------
# TwinCAT 3 / Visual Studio .gitignore
# Keeps source (.TcPOU, .TcGVL, .TcDUT, .TcVIS, .plcproj, .tsproj,
# .sln, _Config/) and ignores everything generated on build.
# ---------------------------------------------------------------

# --- Visual Studio / XAE editor files ---
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- TwinCAT build output ---
_Boot/
_CompileInfo/
_CompileInfo_Upload/
_Libraries/
_ModuleInstall/
*.compiled-library*
*.tmc
*.tmcRefac
*.tpy
*.~u
LineIDs.dbg
LineIDs.dbg.bak

# --- Backups ---
*.bak
*.orig

# --- Licenses (machine-specific, generated by TwinCAT) ---
*.tclrs

# --- Exported solution / project archives ---
*.tnzip
*.tszip
*.tpzip

# --- OS files ---
Thumbs.db
Desktop.ini
.DS_Store
